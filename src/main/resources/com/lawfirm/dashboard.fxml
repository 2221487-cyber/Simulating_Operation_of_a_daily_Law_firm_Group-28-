<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.Pane?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lawfirm.controllers.DashboardController">
   <children>
      <Label text="CourtAlert - Law Firm Management System" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-padding: 20;">
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
      </Label>
      
      <HBox spacing="10" alignment="CENTER_LEFT">
         <children>
            <Button fx:id="btnNewClient" text="Create New Client" onAction="#initialize" style="-fx-font-size: 14px; -fx-pref-width: 180; -fx-pref-height: 40;" />
         </children>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" />
         </VBox.margin>
      </HBox>
      
      <Label text="Goals" style="-fx-font-size: 18px; -fx-font-weight: bold;">
         <VBox.margin>
            <Insets bottom="10.0" left="20.0" top="10.0" />
         </VBox.margin>
      </Label>
      
      <GridPane hgap="10" vgap="10" alignment="CENTER">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="120.0" prefWidth="120.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="40.0" prefHeight="40.0" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <Button fx:id="btnGoal1" text="Goal 1" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <Button fx:id="btnGoal2" text="Goal 2" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            <Button fx:id="btnGoal3" text="Goal 3" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="2" GridPane.rowIndex="0" />
            <Button fx:id="btnGoal4" text="Goal 4" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />
            <Button fx:id="btnGoal5" text="Goal 5" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <Button fx:id="btnGoal6" text="Goal 6" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Button fx:id="btnGoal7" text="Goal 7" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="2" GridPane.rowIndex="1" />
            <Button fx:id="btnGoal8" text="Goal 8" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />
            <Button fx:id="btnGoal9" text="Goal 9" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <Button fx:id="btnGoal10" text="Goal 10" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <Button fx:id="btnGoal11" text="Goal 11" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="2" GridPane.rowIndex="2" />
            <Button fx:id="btnGoal12" text="Goal 12" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            <Button fx:id="btnGoal13" text="Goal 13" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <Button fx:id="btnGoal14" text="Goal 14" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Button fx:id="btnGoal15" text="Goal 15" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="2" GridPane.rowIndex="3" />
            <Button fx:id="btnGoal16" text="Goal 16" onAction="#initialize" prefWidth="120.0" prefHeight="40.0" GridPane.columnIndex="3" GridPane.rowIndex="3" />
         </children>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" />
         </VBox.margin>
      </GridPane>
   </children>
</VBox>
