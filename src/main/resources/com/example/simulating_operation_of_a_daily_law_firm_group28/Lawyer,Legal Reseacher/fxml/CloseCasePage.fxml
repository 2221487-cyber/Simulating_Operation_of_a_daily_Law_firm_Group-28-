<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_daily_law_firm_group28.LawyerLegalResearcher.controllers.lawyer.CloseCaseController">
   <children>
      <VBox prefHeight="600.0" prefWidth="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #2196F3; -fx-padding: 15;">
               <children>
                  <Label text="Close Case" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleBack" text="Back to Dashboard" />
               </children>
            </HBox>
            <VBox alignment="CENTER" spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f5f5f5; -fx-padding: 30; -fx-background-radius: 10;" prefWidth="700.0">
                     <children>
                        <Label text="Select Case to Close:" />
                        <ComboBox fx:id="caseComboBox" prefWidth="650.0" />
                        <Label text="Case Information:" />
                        <VBox spacing="5.0" prefWidth="650.0">
                           <children>
                              <Label fx:id="caseInfoLabel" text="" wrapText="true" />
                           </children>
                        </VBox>
                        <Label fx:id="warningLabel" text="Warning: Once closed, the case cannot be edited." textFill="RED" wrapText="true" />
                        <CheckBox fx:id="confirmCheckBox" text="I confirm that I want to close this case" />
                        <Label fx:id="messageLabel" textFill="GREEN" visible="false" />
                        <Button fx:id="closeCaseButton" mnemonicParsing="false" onAction="#handleCloseCase" text="Close Case" prefWidth="650.0" style="-fx-background-color: #f44336; -fx-text-fill: white;">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Button>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>

