<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_daily_law_firm_group28.LawyerLegalResearcher.controllers.LawyerDashboardController">
   <children>
      <VBox prefHeight="600.0" prefWidth="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #2196F3; -fx-padding: 15;">
               <children>
                  <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Lawyer Dashboard">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Text>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="logoutButton" mnemonicParsing="false" onAction="#handleLogout" text="Logout" />
               </children>
            </HBox>
            <Label fx:id="welcomeLabel" text="Welcome, Lawyer" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </Label>
            <GridPane hgap="15.0" vgap="15.0" VBox.vgrow="ALWAYS">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <Button fx:id="createCaseButton" mnemonicParsing="false" onAction="#navigateToCreateCase" prefHeight="80.0" prefWidth="180.0" text="Create New Case File" GridPane.columnIndex="0" GridPane.rowIndex="0" wrapText="true" />
                  <Button fx:id="updateStatusButton" mnemonicParsing="false" onAction="#navigateToUpdateStatus" prefHeight="80.0" prefWidth="180.0" text="Update Case Status" GridPane.columnIndex="1" GridPane.rowIndex="0" wrapText="true" />
                  <Button fx:id="manageHearingButton" mnemonicParsing="false" onAction="#navigateToManageHearing" prefHeight="80.0" prefWidth="180.0" text="Manage Hearing Dates" GridPane.columnIndex="2" GridPane.rowIndex="0" wrapText="true" />
                  <Button fx:id="uploadDocumentsButton" mnemonicParsing="false" onAction="#navigateToUploadDocuments" prefHeight="80.0" prefWidth="180.0" text="Upload Case Documents" GridPane.columnIndex="3" GridPane.rowIndex="0" wrapText="true" />
                  <Button fx:id="viewClientButton" mnemonicParsing="false" onAction="#navigateToViewClient" prefHeight="80.0" prefWidth="180.0" text="View Client Details" GridPane.columnIndex="0" GridPane.rowIndex="1" wrapText="true" />
                  <Button fx:id="generateReportButton" mnemonicParsing="false" onAction="#navigateToGenerateReport" prefHeight="80.0" prefWidth="180.0" text="Generate Case Progress Report" GridPane.columnIndex="1" GridPane.rowIndex="1" wrapText="true" />
                  <Button fx:id="trackBillingButton" mnemonicParsing="false" onAction="#navigateToTrackBilling" prefHeight="80.0" prefWidth="180.0" text="Track Billing and Payments" GridPane.columnIndex="2" GridPane.rowIndex="1" wrapText="true" />
                  <Button fx:id="closeCaseButton" mnemonicParsing="false" onAction="#navigateToCloseCase" prefHeight="80.0" prefWidth="180.0" text="Close Case" GridPane.columnIndex="3" GridPane.rowIndex="1" wrapText="true" />
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </GridPane>
         </children>
      </VBox>
   </children>
</AnchorPane>

