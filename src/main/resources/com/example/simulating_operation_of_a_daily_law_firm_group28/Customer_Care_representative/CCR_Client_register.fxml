<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.simulating_operation_of_a_daily_law_firm_group28.Customer_Care_representative.Controller.CCR_Client_registrationcontroller">

    <children>
        <Label layoutX="25.0" layoutY="34.0" text="Client Name" />
        <TextField fx:id="TFClientRegClientName" layoutX="150.0" layoutY="30.0" />

        <Label layoutX="25.0" layoutY="71.0" text="Contact Number" />
        <TextField fx:id="TFClientRegContactNum" layoutX="150.0" layoutY="67.0" />

        <Label layoutX="25.0" layoutY="110.0" text="Case Type" />
        <ComboBox fx:id="CBClientRegCaseType" layoutX="150.0" layoutY="106.0" prefWidth="170.0" />

        <Label layoutX="25.0" layoutY="149.0" text="Preferred Lawyer" />
        <ComboBox fx:id="CBClientRegPreferredLawyer" layoutX="150.0" layoutY="145.0" prefWidth="170.0" />

        <Button text="Register Client" layoutX="50.0" layoutY="210.0" onAction="#buttonClientReg" />
        <Button text="Back" layoutX="170.0" layoutY="210.0" onAction="#buttonClientRegBack" />

        <Label fx:id="labelRegisterClientStatus" layoutX="270.0" layoutY="215.0" text="" />
    </children>
</AnchorPane>
