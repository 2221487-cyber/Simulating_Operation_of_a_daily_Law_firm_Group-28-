<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="550.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_daily_law_firm_group28.Customer_Care_representative.Controller.CCR_Appoinment_schedulecontroller">
   <children>
      <!-- Title -->
      <Label layoutX="40.0" layoutY="10.0" text="Schedule Appointment" />
      
      <!-- Input Fields -->
      <Label fx:id="TFScheduleClientId" layoutX="40.0" layoutY="45.0" text="Client Id" />
      <TextField fx:id="TFScheduleAppoinmentClientname" layoutX="140.0" layoutY="41.0" prefWidth="200.0" />
      
      <Label fx:id="TFScheduleLawyerId" layoutX="40.0" layoutY="85.0" text="Lawyer ID" />
      <TextField fx:id="TFScheduleAppoinmentLawyerId" layoutX="140.0" layoutY="81.0" prefWidth="200.0" />
      
      <Label fx:id="DPScheduleAppoinment" layoutX="40.0" layoutY="125.0" text="Date" />
      <DatePicker fx:id="DPScheduleAppoinmentDate" layoutX="140.0" layoutY="121.0" prefWidth="200.0" />
      
      <Label fx:id="CBScheduleTime" layoutX="40.0" layoutY="165.0" text="Time slots" />
      <ComboBox fx:id="CBScheduleAppoinmentTimeSlots" layoutX="140.0" layoutY="161.0" prefWidth="200.0" />
      
      <!-- Buttons -->
      <Button layoutX="140.0" layoutY="205.0" mnemonicParsing="false" onAction="#buttonScheduleAppoinmentSubmit" text="Save Appointment" />
      <Button layoutX="280.0" layoutY="205.0" mnemonicParsing="false" onAction="#buttonRefreshAppointments" text="Refresh" />
      <Button layoutX="370.0" layoutY="205.0" mnemonicParsing="false" onAction="#buttonScheduleAppoinmentBack" text="Back" />
      
      <!-- Appointments Table -->
      <Label layoutX="40.0" layoutY="250.0" text="Scheduled Appointments:" />
      <TableView fx:id="TVAppointments" layoutX="40.0" layoutY="275.0" prefHeight="240.0" prefWidth="570.0">
        <columns>
          <TableColumn fx:id="colAppointmentId" prefWidth="100.0" text="Appointment ID" />
          <TableColumn fx:id="colClientId" prefWidth="100.0" text="Client ID" />
          <TableColumn fx:id="colLawyerId" prefWidth="100.0" text="Lawyer ID" />
          <TableColumn fx:id="colDate" prefWidth="100.0" text="Date" />
          <TableColumn fx:id="colTimeSlot" prefWidth="90.0" text="Time Slot" />
          <TableColumn fx:id="colStatus" prefWidth="80.0" text="Status" />
        </columns>
      </TableView>
   </children>
</AnchorPane>
