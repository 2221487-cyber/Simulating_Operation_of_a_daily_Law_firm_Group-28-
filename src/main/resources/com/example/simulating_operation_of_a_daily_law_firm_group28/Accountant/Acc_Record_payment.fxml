<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.simulating_operation_of_a_daily_law_firm_group28.Accountant.Controller.Acc_RecordPaymentController">

    <children>

        <!-- Client ID -->
        <Label layoutX="40.0" layoutY="35.0" text="Client ID"/>
        <TextField fx:id="paymentClientIdField" layoutX="140.0" layoutY="30.0" prefWidth="200"/>

        <!-- Payment Amount -->
        <Label layoutX="40.0" layoutY="75.0" text="Payment Amount"/>
        <TextField fx:id="paymentAmountField" layoutX="140.0" layoutY="70.0" prefWidth="200"/>

        <!-- Payment Method -->
        <Label layoutX="40.0" layoutY="115.0" text="Payment Method"/>
        <TextField fx:id="paymentMethodField" layoutX="140.0" layoutY="110.0" prefWidth="200"/>

        <!-- Record Payment Button -->
        <Button fx:id="recordPaymentBtn"
                layoutX="360.0" layoutY="30.0"
                onAction="#recordPayment"
                text="Record Payment" />

        <!-- Verify Invoice Button -->
        <Button fx:id="verifyInvoiceBtn"
                layoutX="360.0" layoutY="70.0"
                onAction="#verifyInvoice"
                text="Verify Invoice" />

        <!-- Update Payment Status Button -->
        <Button fx:id="updatePaymentBtn"
                layoutX="360.0" layoutY="110.0"
                onAction="#updatePayment"
                text="Update Payment" />

        <!-- Confirmation Label -->
        <Label fx:id="paymentConfirmationLabel" layoutX="40.0" layoutY="160.0" text=""/>

        <!-- Payment Records Table -->
        <Label layoutX="40.0" layoutY="200.0" text="Payment Records" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        <TableView fx:id="paymentTable" layoutX="40.0" layoutY="230.0" prefHeight="240.0" prefWidth="620.0">
            <columns>
                <TableColumn fx:id="paymentIdCol" text="Payment ID" prefWidth="120.0"/>
                <TableColumn fx:id="clientIdCol" text="Client ID" prefWidth="100.0"/>
                <TableColumn fx:id="amountCol" text="Amount" prefWidth="100.0"/>
                <TableColumn fx:id="methodCol" text="Method" prefWidth="100.0"/>
                <TableColumn fx:id="dateCol" text="Date" prefWidth="100.0"/>
                <TableColumn fx:id="invoiceCol" text="Invoice" prefWidth="100.0"/>
            </columns>
        </TableView>

    </children>
</AnchorPane>
