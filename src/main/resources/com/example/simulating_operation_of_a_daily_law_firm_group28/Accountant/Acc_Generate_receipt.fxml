<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_daily_law_firm_group28.Accountant.Controller.Acc_GenerateReceiptController">

    <children>

        <!-- Title -->
        <Label layoutX="40.0" layoutY="10.0" text="Generate Payment Receipt" />

        <!-- Client ID -->
        <Label layoutX="40.0" layoutY="50.0" text="Client ID:" />
        <TextField fx:id="receiptClientIdField" layoutX="160.0" layoutY="45.0" prefWidth="200" promptText="Enter client ID" />

        <!-- Invoice Number -->
        <Label layoutX="40.0" layoutY="90.0" text="Invoice Number:" />
        <TextField fx:id="receiptInvoiceField" layoutX="160.0" layoutY="85.0" prefWidth="200" promptText="Enter invoice number" />

        <!-- Payment Amount -->
        <Label layoutX="40.0" layoutY="130.0" text="Payment Amount:" />
        <TextField fx:id="paymentAmountField" layoutX="160.0" layoutY="125.0" prefWidth="200" promptText="Enter amount" />

        <!-- Payment Date -->
        <Label layoutX="40.0" layoutY="170.0" text="Payment Date:" />
        <DatePicker fx:id="paymentDatePicker" layoutX="160.0" layoutY="165.0" prefWidth="200" />

        <!-- Payment Method -->
        <Label layoutX="40.0" layoutY="210.0" text="Payment Method:" />

        <!-- Action Buttons -->
        <Button fx:id="buttonverifyPayment" layoutX="380.0" layoutY="85.0" onAction="#verifyPayment" text="Verify Payment" />

        <Button fx:id="buttongenerateReceipt" layoutX="40.0" layoutY="250.0" onAction="#generateReceipt" text="Generate Receipt" />

        <Button fx:id="viewReceiptBtn" layoutX="200.0" layoutY="250.0" onAction="#viewReceipt" text="View Receipt" />

        <!-- Receipt Details Area -->
        <Label layoutX="40.0" layoutY="295.0" text="Receipt Details:" />
        <TextArea fx:id="receiptDetailsArea" editable="false" layoutX="40.0" layoutY="320.0" prefHeight="120" prefWidth="560" promptText="Receipt details will appear here..." wrapText="true" />

        <!-- Status Label -->
        <Label fx:id="statusLabel" layoutX="40.0" layoutY="450.0" text="" />
      <ComboBox fx:id="ComboBoxPaymentMethod" layoutX="160.0" layoutY="206.0" prefWidth="150.0" />

    </children>
</AnchorPane>
