<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>

<VBox xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.simulating_operation_of_a_daily_law_firm_group28.CourtClerkClient.controllers.Goal1Controller">
   <children>
      <Label text="Goal 1" style="-fx-font-size: 24px; -fx-font-weight: bold;">
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </VBox.margin>
      </Label>
      
      <GridPane hgap="10" vgap="15" alignment="CENTER_LEFT">
         <columnConstraints>
            <ColumnConstraints minWidth="120.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="250.0" prefWidth="400.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="30.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="150.0" prefHeight="150.0" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <Label text="Client ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <ComboBox fx:id="comboClient" promptText="Select Client" prefWidth="400.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
            
            <Label text="Goal Title:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtGoalTitle" promptText="Enter goal title" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            
            <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextArea fx:id="txtGoalDescription" promptText="Enter full goal explanation" prefHeight="150.0" prefWidth="400.0" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" right="20.0" />
         </VBox.margin>
      </GridPane>
      
      <HBox spacing="10" alignment="CENTER_LEFT">
         <children>
            <Button fx:id="btnSave" text="Save Goal" onAction="#handleSave" style="-fx-font-size: 14px; -fx-pref-width: 120; -fx-pref-height: 35;" />
            <Button fx:id="btnBack" text="Back to Dashboard" onAction="#handleBack" style="-fx-font-size: 14px; -fx-pref-width: 150; -fx-pref-height: 35;" />
         </children>
         <VBox.margin>
            <Insets bottom="20.0" left="20.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>
