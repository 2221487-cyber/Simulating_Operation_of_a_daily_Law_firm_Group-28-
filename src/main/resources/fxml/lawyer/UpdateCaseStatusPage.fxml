<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lawfirm.controllers.lawyer.UpdateCaseStatusController">
   <children>
      <VBox prefHeight="600.0" prefWidth="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #2196F3; -fx-padding: 15;">
               <children>
                  <Label text="Update Case Status" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleBack" text="Back to Dashboard" />
               </children>
            </HBox>
            <VBox alignment="CENTER" spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f5f5f5; -fx-padding: 30; -fx-background-radius: 10;" prefWidth="700.0">
                     <children>
                        <Label text="Select Case:" />
                        <TableView fx:id="casesTable" prefHeight="200.0" prefWidth="650.0">
                           <columns>
                              <TableColumn fx:id="caseIdColumn" prefWidth="100.0" text="Case ID" />
                              <TableColumn fx:id="titleColumn" prefWidth="200.0" text="Title" />
                              <TableColumn fx:id="typeColumn" prefWidth="100.0" text="Type" />
                              <TableColumn fx:id="statusColumn" prefWidth="150.0" text="Current Status" />
                              <TableColumn fx:id="clientColumn" prefWidth="100.0" text="Client" />
                           </columns>
                        </TableView>
                        <Label text="New Status:" />
                        <ComboBox fx:id="statusComboBox" prefWidth="650.0" />
                        <Label fx:id="messageLabel" textFill="GREEN" visible="false" />
                        <Button fx:id="updateButton" mnemonicParsing="false" onAction="#handleUpdateStatus" text="Update Status" prefWidth="650.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Button>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>

