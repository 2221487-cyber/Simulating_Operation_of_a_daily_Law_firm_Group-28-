<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lawfirm.controllers.lawyer.ManageHearingDatesController">
   <children>
      <VBox prefHeight="600.0" prefWidth="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #2196F3; -fx-padding: 15;">
               <children>
                  <Label text="Manage Hearing Dates" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleBack" text="Back to Dashboard" />
               </children>
            </HBox>
            <VBox alignment="CENTER" spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f5f5f5; -fx-padding: 30; -fx-background-radius: 10;" prefWidth="700.0">
                     <children>
                        <Label text="Select Case:" />
                        <ComboBox fx:id="caseComboBox" prefWidth="650.0" />
                        <Label text="Hearing Date:" />
                        <DatePicker fx:id="hearingDatePicker" prefWidth="650.0" />
                        <Label fx:id="messageLabel" textFill="GREEN" visible="false" />
                        <Button fx:id="updateButton" mnemonicParsing="false" onAction="#handleUpdateHearingDate" text="Update Hearing Date" prefWidth="650.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Button>
                        <Label text="Upcoming Hearings:" />
                        <TableView fx:id="hearingsTable" prefHeight="200.0" prefWidth="650.0">
                           <columns>
                              <TableColumn fx:id="caseTitleColumn" prefWidth="200.0" text="Case Title" />
                              <TableColumn fx:id="hearingDateColumn" prefWidth="200.0" text="Hearing Date" />
                              <TableColumn fx:id="caseStatusColumn" prefWidth="150.0" text="Status" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>

