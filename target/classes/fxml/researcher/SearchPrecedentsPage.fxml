<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lawfirm.controllers.researcher.SearchPrecedentsController">
   <children>
      <VBox prefHeight="600.0" prefWidth="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #4CAF50; -fx-padding: 15;">
               <children>
                  <Label text="Search Legal Precedents" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleBack" text="Back to Dashboard" />
               </children>
            </HBox>
            <VBox alignment="CENTER" spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f5f5f5; -fx-padding: 30; -fx-background-radius: 10;" prefWidth="700.0">
                     <children>
                        <Label text="Keyword:" />
                        <TextField fx:id="keywordField" prefWidth="650.0" />
                        <Label text="Court:" />
                        <TextField fx:id="courtField" prefWidth="650.0" />
                        <Label text="Year:" />
                        <TextField fx:id="yearField" prefWidth="650.0" />
                        <Button fx:id="searchButton" mnemonicParsing="false" onAction="#handleSearch" text="Search" prefWidth="650.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Button>
                        <Label text="Search Results:" />
                        <TableView fx:id="resultsTable" prefHeight="300.0" prefWidth="650.0">
                           <columns>
                              <TableColumn fx:id="titleColumn" prefWidth="200.0" text="Title" />
                              <TableColumn fx:id="courtColumn" prefWidth="150.0" text="Court" />
                              <TableColumn fx:id="yearColumn" prefWidth="100.0" text="Year" />
                              <TableColumn fx:id="summaryColumn" prefWidth="200.0" text="Summary" />
                           </columns>
                        </TableView>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>

