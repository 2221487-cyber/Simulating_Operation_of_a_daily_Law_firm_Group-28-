<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lawfirm.controllers.researcher.ComparePrecedentsController">
   <children>
      <VBox prefHeight="600.0" prefWidth="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #4CAF50; -fx-padding: 15;">
               <children>
                  <Label text="Compare Two Precedents" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#handleBack" text="Back to Dashboard" />
               </children>
            </HBox>
            <VBox alignment="CENTER" spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f5f5f5; -fx-padding: 30; -fx-background-radius: 10;" prefWidth="700.0">
                     <children>
                        <HBox spacing="10.0">
                           <children>
                              <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Precedent 1:" />
                                    <ComboBox fx:id="precedent1ComboBox" prefWidth="300.0" />
                                 </children>
                              </VBox>
                              <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Precedent 2:" />
                                    <ComboBox fx:id="precedent2ComboBox" prefWidth="300.0" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <Button fx:id="compareButton" mnemonicParsing="false" onAction="#handleCompare" text="Compare" prefWidth="650.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Button>
                        <HBox spacing="10.0" prefHeight="350.0">
                           <children>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Precedent 1 Details:" />
                                    <TextArea fx:id="precedent1Area" editable="false" prefHeight="300.0" wrapText="true" />
                                 </children>
                              </VBox>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Precedent 2 Details:" />
                                    <TextArea fx:id="precedent2Area" editable="false" prefHeight="300.0" wrapText="true" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>

